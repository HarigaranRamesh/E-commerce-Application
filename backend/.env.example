# Server Configuration
NODE_ENV=development
PORT=5001

# PostgreSQL Database Configuration
# Format: postgresql://username:password@localhost:5432/ecommerce
# Cloud providers (Supabase, Neon, Render, Railway) provide a full connection string:
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce

# Optional individual PG connection parameters:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=ecommerce

# JWT Configuration
JWT_SECRET=ecommerce_secret_jwt_key_super_secure_min_32_chars
JWT_EXPIRE=7d

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Strapi Headless CMS Configuration
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=
STRAPI_WEBHOOK_SECRET=your_strapi_webhook_secret_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
