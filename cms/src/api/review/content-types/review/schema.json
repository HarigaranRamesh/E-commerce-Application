{
  "kind": "collectionType",
  "collectionName": "reviews",
  "info": {
    "singularName": "review",
    "pluralName": "reviews",
    "displayName": "Review",
    "description": "Customer Ratings & Reviews"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "user_name": {
      "type": "string",
      "required": true
    },
    "rating": {
      "type": "integer",
      "min": 1,
      "max": 5,
      "default": 5,
      "required": true
    },
    "comment": {
      "type": "text",
      "required": true
    },
    "product_id": {
      "type": "string",
      "required": true
    }
  }
}
